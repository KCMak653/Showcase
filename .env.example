# --- LLM provider ---
# Supported: openrouter | openai | ollama | kimi
LLM_PROVIDER=openrouter
LLM_MODEL=deepseek/deepseek-chat-v3-0324

# OpenAI (LLM_PROVIDER=openai)
OPENAI_API_KEY=

# OpenRouter (LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=

# Ollama (LLM_PROVIDER=ollama)
# Cloud: https://ollama.com/settings/keys
# Local: ollama serve (use http://localhost:11434/v1)
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=
# Free cloud models: gemma4:31b | gpt-oss:120b | gpt-oss:20b | nemotron-3-nano:30b | nemotron-3-super | nemotron-3-ultra
OLLAMA_MODEL=gpt-oss:20b

# Kimi Code / Allegro subscription (LLM_PROVIDER=kimi)
# NOT the Moonshot pay-as-you-go API (api.moonshot.cn)
KIMI_API_KEY=
KIMI_BASE_URL=https://api.kimi.com/coding/v1
# Model IDs: k3 | k3-256k | kimi-for-coding | kimi-for-coding-highspeed
KIMI_MODEL=kimi-for-coding

# Cursor (agent SDK only — not supported for scrape/format pipeline)
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5

# --- Spotify (required for artist matching + playlist creation) ---
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- Supabase (optional; for pipelines/load_shows.py) ---
SUPABASE_URL=
SUPABASE_KEY=
