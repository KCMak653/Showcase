# --- LLM provider ---
# Supported: openrouter | openai | ollama | kimi
# Note: cursor is listed below for reference but is NOT a drop-in chat provider for Showcase.
LLM_PROVIDER=openrouter
LLM_MODEL=deepseek/deepseek-chat-v3-0324

# OpenAI (LLM_PROVIDER=openai)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter (LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=

# Ollama (LLM_PROVIDER=ollama)
# Cloud (free tier): key from https://ollama.com/settings/keys
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=
# Free cloud models:
#   gemma4:31b | gpt-oss:120b | gpt-oss:20b | nemotron-3-nano:30b | nemotron-3-super | nemotron-3-ultra
OLLAMA_MODEL=gpt-oss:20b
# Local alternative (requires: ollama serve && ollama signin):
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=ollama
# OLLAMA_MODEL=llama3.2

# Kimi Code / Allegro subscription (LLM_PROVIDER=kimi)
# Keys: Kimi Code Console — NOT Moonshot Open Platform (api.moonshot.cn)
# Docs: https://www.kimi.com/code/docs/en/
# OpenAI-compatible base URL:
KIMI_API_KEY=
KIMI_BASE_URL=https://api.kimi.com/coding/v1
# Model IDs: k3 | k3-256k | kimi-for-coding | kimi-for-coding-highspeed
# Use the ID exactly — not display names like "Kimi K3"
KIMI_MODEL=kimi-for-coding

# Cursor (agent SDK only — not wired into Showcase scrape/format pipeline)
# Get key: Cursor Dashboard → API Keys
# Used by @cursor/sdk for coding agents, not simple chat completions.
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5

# --- Spotify (required for artist matching + playlist creation) ---
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- Supabase (optional; for pipelines/load_shows.py) ---
SUPABASE_URL=
SUPABASE_KEY=
